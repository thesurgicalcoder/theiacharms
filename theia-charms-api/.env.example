PORT=5000
NODE_ENV=development

# ---- Database: SQLite. Nothing to install - the file is created automatically. ----
# SQLITE_PATH=./data/theia.db

# Allowed browser origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Secret used to sign logins. In development you can leave it empty (one is generated into ./data/jwt.secret).
# In production set a long random value:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First owner account - created automatically on first start. CHANGE THESE.
INITIAL_OWNER_NAME=Owner
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_PASSWORD=ChangeMe_Strong_Password_1!

# Default public settings (editable later in Admin -> Settings)
WHATSAPP_PHONE=919876543210
ADMIN_URL=http://localhost:5174

# ---- Photos ----
# By default uploaded photos are saved in ./uploads and served by this API (no account needed).
# UPLOAD_DIR=./uploads
# PUBLIC_API_URL=https://your-api.example.com      (only if photo links come out wrong behind a proxy)
# Optional: use Cloudinary instead (free plan) by filling all three:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- AI import (PDF -> products). Optional. FREE option: Google Gemini key from https://aistudio.google.com ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
